flowchart TB
  classDef gate fill:#FFF4E5,stroke:#C25E00,color:#1B1B1B
  classDef ai fill:#E6F2FB,stroke:#0078D4,color:#1B1B1B
  classDef human fill:#E8F5E9,stroke:#2E7D32,color:#1B1B1B
  classDef out fill:#F3F2F1,stroke:#605E5C,color:#1B1B1B

  R1{"1 · Readiness check<br/>Is the information<br/>sufficient?"}:::gate
  Q0["Ask the business<br/>for missing details"]:::human
  M["2 · Model recommendation<br/>(human confirms for<br/>high-impact stages)"]:::gate
  G["3 · Specialised agent<br/>drafts the artifact"]:::ai
  QC{"4 · Independent quality check<br/>contract + scoring by a<br/>different AI model"}:::gate
  FIX["Revise using the<br/>reviewer's findings"]:::ai
  PR["5 · Pull request<br/>human review & approval"]:::human
  NX(["Next stage starts<br/>automatically"]):::out

  R1 -- no --> Q0 --> R1
  R1 -- yes --> M --> G --> QC
  QC -- "below threshold" --> FIX --> QC
  QC -- pass --> PR --> NX
  PR -- "changes requested" --> FIX
