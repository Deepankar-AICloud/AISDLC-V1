flowchart LR
  classDef fe fill:#E8F5E9,stroke:#2E7D32,color:#1B1B1B
  classDef be fill:#E6F2FB,stroke:#0078D4,color:#1B1B1B
  classDef data fill:#F3E5F5,stroke:#6A1B9A,color:#1B1B1B
  classDef ext fill:#F3F2F1,stroke:#605E5C,stroke-dasharray:4 3,color:#1B1B1B

  subgraph Client["Browser (untrusted zone)"]
    SPA["React 18 SPA<br/>App.tsx / api.ts / auth.ts"]:::fe
    MSAL["MSAL Browser<br/>sessionStorage token cache"]:::fe
  end
  subgraph API["SmartServe.Api (.NET 8, App Service)"]
    MW["ASP.NET Core pipeline<br/>HTTPS, headers, CORS, AuthN, AuthZ"]:::be
    CTRL["Controllers<br/>AccessRequests, Audit"]:::be
    WF["WorkflowService<br/>stage routing rules"]:::be
    EF["SmartServeDbContext<br/>EF Core 8"]:::be
    HC["/health<br/>EF Core health check"]:::be
  end
  SQL[("Azure SQL<br/>SmartServeDb")]:::data
  MEM[("EF In-Memory DB<br/>local dev only")]:::data
  ENTRA["Microsoft Entra ID"]:::ext
  KV["Azure Key Vault"]:::ext
  AI["Application Insights"]:::ext

  SPA -->|"fetch /api/* + Bearer token<br/>+ x-correlation-id"| MW
  SPA --- MSAL
  MSAL -.->|"acquireTokenSilent<br/>(no sign-in call implemented)"| ENTRA
  MW --> CTRL --> WF
  CTRL --> EF
  HC --> EF
  EF -->|"connection string set"| SQL
  EF -.->|"no connection string"| MEM
  MW -->|"JWT validation metadata"| ENTRA
  API -.->|"config provider (Managed Identity)"| KV
  API -.->|"telemetry SDK"| AI
