flowchart TB
  classDef fe fill:#E8F5E9,stroke:#2E7D32,color:#1B1B1B
  classDef be fill:#E6F2FB,stroke:#0078D4,color:#1B1B1B
  classDef data fill:#F3E5F5,stroke:#6A1B9A,color:#1B1B1B
  classDef ext fill:#F3F2F1,stroke:#605E5C,stroke-dasharray:4 3,color:#1B1B1B

  subgraph Client["Browser (untrusted zone)"]
    SPA["React 18 SPA<br/>App.tsx / AdminRequestTypesPage / api.ts"]:::fe
    MSAL["MSAL Browser + React<br/>redirect sign-in, sessionStorage"]:::fe
  end
  subgraph API["SmartServe.Api (.NET 8, App Service, VNet-integrated)"]
    MW["ASP.NET Core pipeline<br/>HTTPS, headers, CORS, AuthN,<br/>Auditor write-block, AuthZ"]:::be
    CTRL["Controllers<br/>Requests, RequestTypes,<br/>Audit, SecurityReview"]:::be
    WF["WorkflowService<br/>transitions + audit + concurrency"]:::be
    NS["NotificationService<br/>+ reconciliation job"]:::be
    EF["SmartServeDbContext<br/>EF Core 8 + migration"]:::be
  end
  SQL[("Azure SQL<br/>SmartServeDb<br/>private endpoint")]:::data
  MEM[("EF In-Memory DB<br/>Development / Testing only")]:::data
  ENTRA["Microsoft Entra ID"]:::ext
  GRAPH["Microsoft Graph<br/>users, manager, sendMail"]:::ext
  KV["Azure Key Vault<br/>private endpoint"]:::ext
  AI["Application Insights"]:::ext

  SPA -->|"fetch /api/* + Bearer token<br/>+ x-correlation-id"| MW
  SPA --- MSAL
  MSAL -->|"loginRedirect / acquireTokenSilent"| ENTRA
  MW --> CTRL --> WF
  WF --> NS
  CTRL --> EF
  WF --> EF
  NS --> EF
  EF -->|"managed identity"| SQL
  EF -.->|"no connection string"| MEM
  MW -->|"JWT validation metadata"| ENTRA
  WF -->|"manager lookup"| GRAPH
  NS -->|"sendMail"| GRAPH
  API -.->|"config (MI)"| KV
  API -.->|"telemetry"| AI
