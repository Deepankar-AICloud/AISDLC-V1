stateDiagram-v2
  direction LR
  [*] --> REQUIREMENT_RECEIVED
  REQUIREMENT_RECEIVED --> BRD_GENERATION
  BRD_GENERATION --> BRD_APPROVED: QC pass + PR approved
  BRD_APPROVED --> PRD_GENERATION
  PRD_GENERATION --> PRD_APPROVED
  PRD_APPROVED --> EPIC_GENERATION
  EPIC_GENERATION --> EPIC_APPROVED
  EPIC_APPROVED --> ARCHITECTURE_GENERATION
  ARCHITECTURE_GENERATION --> ARCHITECTURE_APPROVED
  ARCHITECTURE_APPROVED --> NFR_GENERATION
  NFR_GENERATION --> NFR_APPROVED
  NFR_APPROVED --> TASK_GENERATION
  TASK_GENERATION --> TASK_APPROVED
  TASK_APPROVED --> CODE_GENERATION
  CODE_GENERATION --> CODE_APPROVED
  CODE_APPROVED --> DEV_DEPLOYMENT
  DEV_DEPLOYMENT --> RELEASE_APPROVAL: functional, perf, staging, security stages (not agent-driven)
  RELEASE_APPROVAL --> PRODUCTION_DEPLOYMENT
  PRODUCTION_DEPLOYMENT --> COMPLETED
  COMPLETED --> [*]

  state "Pause / fail-safe states (any generation stage)" as P {
    AWAITING_MODEL_CONFIRMATION
    AWAITING_REQUIRED_INFORMATION
    NEEDS_HUMAN_INTERVENTION
  }
