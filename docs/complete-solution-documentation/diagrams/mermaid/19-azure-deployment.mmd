flowchart TB
  classDef web fill:#E6F2FB,stroke:#0078D4,color:#1B1B1B
  classDef data fill:#F3E5F5,stroke:#6A1B9A,color:#1B1B1B
  classDef sec fill:#E8F5E9,stroke:#2E7D32,color:#1B1B1B
  classDef obs fill:#FFF8E1,stroke:#C19C00,color:#1B1B1B

  subgraph RG["Azure resource group (one per environment; DEV = rg-aisdlc-v1, deployed)"]
    PLAN["App Service Plan (Linux)<br/>B1 (dev) · S1 (staging) · P1v3 (production)"]:::web
    API["API App Service<br/>DOTNETCORE|8.0 · httpsOnly · FTPS disabled<br/>VNet integration (route-all)"]:::web
    SLOT["API slot 'staging'<br/>staging/production only"]:::web
    WEB["Web App Service<br/>NODE|22-lts · pm2 serve --spa"]:::web
    UAMI["User-assigned identity<br/>smartserve-env-api-id"]:::sec
    VNET["VNet 10.40.0.0/16<br/>subnets: app · private-endpoints"]:::sec
    SQLS["Azure SQL server<br/>Entra-only · public access disabled"]:::data
    SQLDB[("SmartServeDb<br/>Basic · S1 zone-redundant (production)")]:::data
    ST["Storage account<br/>public access + shared keys disabled"]:::data
    KV["Key Vault (RBAC, soft delete)<br/>public access disabled"]:::sec
    PE["Private endpoints + private DNS<br/>SQL · Key Vault"]:::sec
    LAW["Log Analytics<br/>30 d / 90 d retention"]:::obs
    AI["Application Insights (workspace-based)"]:::obs
  end
  PLAN --- API & WEB
  API -.- SLOT
  API --- UAMI
  API --- VNET --- PE
  PE --> SQLS
  PE --> KV
  SQLS --- SQLDB
  UAMI -->|"SQL Entra admin"| SQLS
  UAMI -->|"Key Vault Secrets User"| KV
  UAMI -->|"Storage Blob Data Contributor"| ST
  API -.->|"ApplicationInsights__ConnectionString"| AI
  AI --> LAW
