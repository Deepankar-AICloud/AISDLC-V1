flowchart TB
  classDef web fill:#E6F2FB,stroke:#0078D4,color:#1B1B1B
  classDef data fill:#F3E5F5,stroke:#6A1B9A,color:#1B1B1B
  classDef sec fill:#E8F5E9,stroke:#2E7D32,color:#1B1B1B
  classDef obs fill:#FFF8E1,stroke:#C19C00,color:#1B1B1B

  subgraph RG["Azure resource group (one per environment: dev / staging / production)"]
    PLAN["App Service Plan (Linux)<br/>B1 (dev/staging) · P1v3 (production)"]:::web
    API["API App Service<br/>DOTNETCORE|8.0 · httpsOnly · FTPS disabled<br/>healthCheckPath /health · system-assigned MI"]:::web
    SLOT["API slot 'staging'<br/>same runtime + settings, own MI"]:::web
    WEB["Web App Service<br/>NODE|20-lts · httpsOnly"]:::web
    SQLS["Azure SQL logical server<br/>TLS 1.2 · public access Enabled"]:::data
    SQLDB[("SmartServeDb<br/>Basic (dev/staging) · S1 zone-redundant (production)")]:::data
    ST["Storage account StorageV2<br/>LRS / ZRS · no public blob"]:::data
    KV["Key Vault (RBAC, soft delete)"]:::sec
    LAW["Log Analytics<br/>30 d / 90 d retention"]:::obs
    AI["Application Insights (workspace-based)"]:::obs
  end
  PLAN --- API & WEB
  API --- SLOT
  API -->|"MI: AD Managed Identity auth (conn string)"| SQLDB
  SQLS --- SQLDB
  API -->|"MI: Key Vault Secrets User"| KV
  API -->|"MI: Storage Blob Data Contributor"| ST
  API & SLOT -.->|"ApplicationInsights__ConnectionString"| AI
  WEB -.->|"no App Insights setting"| AI
  AI --> LAW
