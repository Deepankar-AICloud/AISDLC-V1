  API["SmartServe.Api<br/>ILogger + App Insights SDK<br/>requests, dependencies (SQL, Graph), exceptions"]:::src
  HC["/health<br/>DB connectivity, token required"]:::src
  AUD[("RequestAudits<br/>status history")]:::src
  NR[("NotificationRecords<br/>Accepted / NotSent / Failed")]:::src
  REC["Reconciliation job<br/>every 5 min: stale Pending → Failed"]:::src
  ASP["App Service health check<br/>probes /health (receives 401)"]:::src
  AI["Application Insights"]:::sink
  LAW["Log Analytics workspace"]:::sink
  WFH["DEV smoke test<br/>API up (401/200), web 200"]:::src
  EVD["Release evidence pack<br/>reports/&lt;run&gt;/release-evidence.*"]:::sink
  SDLC["Agentic SDLC telemetry<br/>reports/&lt;run&gt;/usage.json, dashboard.json"]:::sink
  G["Not found in workspace:<br/>alert rules, dashboards, diagnostic settings,<br/>SPA telemetry, availability tests"]:::gap

  API --> AI --> LAW
  ASP --> HC
  WFH --> HC
  API --> AUD
  API --> NR
  REC --> NR
  WFH --> EVD
