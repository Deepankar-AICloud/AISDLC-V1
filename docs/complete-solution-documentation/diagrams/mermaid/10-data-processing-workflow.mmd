  Z["Authorization<br/>policies + own-request filter + Auditor write-block"]:::proc
  W["WorkflowService<br/>Submit / Route / Decide / Fulfil"]:::proc
  NS["NotificationService<br/>Graph sendMail"]:::proc
  T1[("PortalRequests")]:::store
  T2[("RequestTypes")]:::store
  T3[("NotificationRecords")]:::store
  T4[("RequestAudits<br/>same transaction as status")]:::store
  O1["RequestResponse JSON"]:::out
  O2["Paged audit and security-review results"]:::out

  IN1 --> V --> Z --> W --> T1
  IN2 --> V
  IN3 --> V
  Z --> T2
  W --> T4
  W --> NS --> T3
