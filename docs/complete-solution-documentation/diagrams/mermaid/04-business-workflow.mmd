flowchart TD
  classDef human fill:#E8F5E9,stroke:#2E7D32,color:#1B1B1B
  classDef sys fill:#E6F2FB,stroke:#0078D4,color:#1B1B1B
  classDef term fill:#F3F2F1,stroke:#605E5C,color:#1B1B1B
  classDef gap fill:#FFF4E5,stroke:#C25E00,stroke-dasharray:4 3,color:#1B1B1B

  S(["Employee needs IT access or service"]):::term
  C["Submit request<br/>title, description, category"]:::human
  R{"Category security-sensitive?<br/>Production, Database, Azure, VPN"}:::sys
  M["Manager decision"]:::human
  SR["Security reviewer decision"]:::human
  IT["IT admin processing decision"]:::human
  P["Status: Provisioned"]:::sys
  CF["Employee confirms provisioning"]:::human
  CL(["Status: Closed"]):::term
  RJ(["Status: Rejected"]):::term
  N["Notifications<br/>NOT implemented in current code"]:::gap

  S --> C --> R
  R -->|"flag set at creation"| M
  M -->|"approve + sensitive"| SR
  M -->|"approve + not sensitive"| IT
  SR -->|approve| IT
  IT -->|approve| P --> CF --> CL
  M -->|reject| RJ
  SR -->|reject| RJ
  IT -->|reject| RJ
  C -.-> N
