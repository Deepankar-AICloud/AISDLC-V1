flowchart TD
  classDef human fill:#E8F5E9,stroke:#2E7D32,color:#1B1B1B
  classDef sys fill:#E6F2FB,stroke:#0078D4,color:#1B1B1B
  classDef term fill:#F3F2F1,stroke:#605E5C,color:#1B1B1B
  classDef gap fill:#FFF4E5,stroke:#C25E00,stroke-dasharray:4 3,color:#1B1B1B

  S(["Employee needs IT access or service"]):::term
  C["Submit request<br/>kind, request type, title, description"]:::human
  K{"Kind?"}:::sys
  SV(["Service request: stays Submitted<br/>(onward workflow is an open question)"]):::gap
  MG{"Manager found<br/>in Entra ID?"}:::sys
  RT["IT admin retries routing"]:::human
  M["Manager decision"]:::human
  AP["Status: Approved"]:::sys
  IT["IT admin fulfils"]:::human
  FU(["Status: Fulfilled"]):::term
  RJ(["Status: Rejected"]):::term
  N["E-mail notifications<br/>requester at each step, manager on routing"]:::sys

  S --> C --> K
  K -->|Service| SV
  K -->|Access| MG
  MG -->|"yes: UnderReview"| M
  MG -->|"no: stays Submitted"| RT --> MG
  M -->|approve| AP --> IT --> FU
  M -->|reject| RJ
  C -.-> N
  M -.-> N
  IT -.-> N
