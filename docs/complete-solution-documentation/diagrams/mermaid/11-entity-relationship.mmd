erDiagram
  RequestType ||--o{ PortalRequest : "FK RequestTypeId (restrict delete)"
  PortalRequest |o..o{ RequestAudit : "PortalRequestId (no FK constraint)"
  PortalRequest |o..o{ NotificationRecord : "PortalRequestId (no FK constraint)"

  RequestType {
    guid Id PK
    string Kind "Access or Service, as string"
    string Name "max 200"
    string Description "max 2000, nullable"
    bool IsActive "indexed with Kind"
    datetimeoffset CreatedAt
    datetimeoffset UpdatedAt "nullable"
    datetimeoffset DeactivatedAt "nullable, one-way"
  }
  PortalRequest {
    guid Id PK
    string Kind "indexed"
    guid RequestTypeId FK "indexed"
    string Title "max 200"
    string Description "max 4000"
    string Status "indexed"
    string RequesterId "max 200, indexed"
    string ManagerId "nullable, indexed"
    string FulfilledById "nullable"
    datetimeoffset CreatedAt
    datetimeoffset UpdatedAt "nullable"
    guid RowVersion "concurrency token"
  }
  RequestAudit {
    long Id PK
    guid PortalRequestId "indexed"
    string ActorId "max 200"
    string OldStatus "nullable"
    string NewStatus
    datetimeoffset Timestamp "indexed"
  }
  NotificationRecord {
    guid Id PK
    guid PortalRequestId "indexed"
    string Template
    string RecipientRole "Requester or Manager"
    string RecipientAddress "max 320, nullable"
    string Status "Pending, Accepted, NotSent, Failed"
    string Reason "max 200, nullable"
    datetimeoffset LeaseExpiresAt "indexed with Status"
    datetimeoffset CompletedAt "nullable"
    guid RowVersion "concurrency token"
  }
