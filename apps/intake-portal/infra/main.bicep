targetScope = 'subscription'

@minLength(1)
@maxLength(64)
@description('azd environment name. Names the resource group and seeds unique resource names.')
param environmentName string

@minLength(1)
@description('Azure region for all resources.')
param location string

@description('Object ID of the identity running azd. Gets AcrPush so azd can push the Studio image.')
param principalId string = ''

@allowed([
  'User'
  'ServicePrincipal'
  'Group'
])
param principalType string = 'User'

@secure()
@description('Shared Studio sign-in password. Generated by azd on first provision; never printed or committed.')
@metadata({
  azd: {
    type: 'generate'
    config: {
      length: 24
      noSpecial: true
    }
  }
})
param studioPassword string

@secure()
@description('Session cookie signing key (32+ characters). Generated by azd on first provision.')
@metadata({
  azd: {
    type: 'generate'
    config: {
      length: 48
      noSpecial: true
    }
  }
})
param sessionSecret string

@secure()
@description('Optional fine-grained GitHub PAT with the Copilot Requests permission. Empty runs offline templates (no AI).')
param copilotGithubToken string = ''

@description('Deployed image (registry/repository:tag). Empty uses a placeholder until azd deploys the Studio image.')
param studioImageName string = ''

@description('Run the Code stage (AI agent builds and tests code in the container).')
param enableCodeStage bool = true

@description('Shared App Service plan SKU for Studio and the portal (e.g. B1, B2, P1v3).')
param appServicePlanSku string = 'P1v3'

// --- Intake Portal ------------------------------------------------------------

@description('Deploy the Intake Portal web app on the shared plan.')
param deployPortal bool = true

@description('Globally unique Intake Portal web app name.')
param portalWebAppName string = 'aisdlc-studio-io'

@description('Deployed portal image (registry/repository:tag). Empty uses a placeholder until azd deploys.')
param portalImageName string = ''

@description('Comma-separated IPv4/IPv6 addresses or CIDRs allowed to reach the portal (no sign-in page).')
param portalAllowedIps string = ''

param portalGithubRepository string = ''
param portalGithubAppId string = ''
param portalGithubAppClientId string = ''

@secure()
param portalGithubAppClientSecret string = ''

@secure()
@description('GitHub App private key PEM, base64-encoded.')
param portalGithubAppPrivateKeyBase64 string = ''

@secure()
@description('Fernet key for stored GitHub user tokens.')
param portalTokenEncryptionKey string = ''

@secure()
@description('Portal session cookie signing key. Generated by azd on first provision.')
@metadata({
  azd: {
    type: 'generate'
    config: {
      length: 48
      noSpecial: true
    }
  }
})
param portalSessionSecret string

@secure()
@description('GitHub webhook secret (required in production). Generated by azd on first provision.')
@metadata({
  azd: {
    type: 'generate'
    config: {
      length: 40
      noSpecial: true
    }
  }
})
param portalWebhookSecret string

var resourceToken = toLower(uniqueString(subscription().id, environmentName, location))
var tags = {
  'azd-env-name': environmentName
}

resource rg 'Microsoft.Resources/resourceGroups@2024-03-01' = {
  name: 'rg-${environmentName}'
  location: location
  tags: tags
}

module resources 'modules/resources.bicep' = {
  name: 'studio-resources'
  scope: rg
  params: {
    location: location
    tags: tags
    resourceToken: resourceToken
    principalId: principalId
    principalType: principalType
    studioPassword: studioPassword
    sessionSecret: sessionSecret
    copilotGithubToken: copilotGithubToken
    studioImageName: studioImageName
    enableCodeStage: enableCodeStage
    appServicePlanSku: appServicePlanSku
  }
}

module portal 'modules/portal.bicep' = if (deployPortal) {
  name: 'portal-resources'
  scope: rg
  params: {
    location: location
    tags: tags
    webAppName: portalWebAppName
    serverFarmResourceId: resources.outputs.appServicePlanId
    pullIdentityResourceId: resources.outputs.pullIdentityResourceId
    pullIdentityClientId: resources.outputs.pullIdentityClientId
    logAnalyticsWorkspaceId: resources.outputs.logAnalyticsWorkspaceId
    imageName: portalImageName
    allowedIpAddresses: filter(map(split(portalAllowedIps, ','), ip => trim(ip)), ip => !empty(ip))
    githubRepository: portalGithubRepository
    githubAppId: portalGithubAppId
    githubAppClientId: portalGithubAppClientId
    githubAppClientSecret: portalGithubAppClientSecret
    githubAppPrivateKeyBase64: portalGithubAppPrivateKeyBase64
    githubWebhookSecret: portalWebhookSecret
    tokenEncryptionKey: portalTokenEncryptionKey
    sessionSecret: portalSessionSecret
  }
}

output AZURE_LOCATION string = location
output AZURE_TENANT_ID string = tenant().tenantId
output AZURE_RESOURCE_GROUP string = rg.name
output AZURE_CONTAINER_REGISTRY_ENDPOINT string = resources.outputs.registryLoginServer
output AZURE_CONTAINER_REGISTRY_NAME string = resources.outputs.registryName
output AZURE_LOG_ANALYTICS_WORKSPACE_ID string = resources.outputs.logAnalyticsWorkspaceId
output SERVICE_STUDIO_NAME string = resources.outputs.webAppName
output STUDIO_URL string = resources.outputs.webAppUrl
output SERVICE_PORTAL_NAME string = deployPortal ? portal!.outputs.webAppName : ''
output PORTAL_URL string = deployPortal ? portal!.outputs.webAppUrl : ''
