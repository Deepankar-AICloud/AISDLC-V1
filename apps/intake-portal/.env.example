# AISDLC Portal configuration reference. The portal does NOT read a .env file: every value comes from an
# environment variable. In Azure, secrets are kept in GitHub Secrets (environment "intake-portal") and
# .github/workflows/deploy-intake-portal.yml copies them into App Service settings. Locally, set the few
# you need in your shell. Never put real values in this file or anywhere in the repository.

# ---------------------------------------------------------------- runtime
# development | test | production. Production enforces https, secrets and process isolation.
APP_ENV=development
# Address uvicorn binds to. AUTH_MODE=dev requires a loopback address.
BIND_HOST=127.0.0.1
# Public URL of the portal (OAuth/OIDC redirects are built from it). Must be https in production.
PUBLIC_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
# Working directory for drafts and pending submissions (use Azure Files or sticky sessions if scaled out).
DATA_DIR=./var
# SQLite locally; PostgreSQL: postgresql+psycopg://user:pass@host:5432/portal
# Azure SQL: mssql+pyodbc://user:pass@server.database.windows.net/portal?driver=ODBC+Driver+18+for+SQL+Server
DATABASE_URL=sqlite:///./var/portal.db
# Signs session cookies. 32+ random characters; required in production.
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=28800
# Extra allowed browser origins (JSON list). Leave empty when the API serves the frontend itself.
CORS_ORIGINS=[]
# Directory of the built frontend to serve (the Docker image sets /app/static).
SERVE_FRONTEND_DIR=

# Password for the "admin" development user (username/password form). Development mode on localhost only.
# Leave empty to disable. Set it in your shell, never in code: PowerShell  $env:DEV_ADMIN_PASSWORD = "..."
DEV_ADMIN_PASSWORD=

# ---------------------------------------------------------------- portal sign-in (Entra ID)
# entra | dev | password. dev shows a localhost user picker; password adds a shared Requester.
# For shared login with real Actions: AUTH_MODE=password, GITHUB_MODE=app, GITHUB_SIGNIN_ENABLED=true.
# Named reviewers still sign in separately. GitHub App settings below remain required.
AUTH_MODE=dev
# Password for the shared "admin" Requester in AUTH_MODE=password. No default; keep server-side.
# admin/admin is allowed only for localhost development/tests. Production requires 12+ characters.
PORTAL_ADMIN_PASSWORD=
RATE_LIMIT_LOGIN_PER_MIN=10
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# App role values defined on the Entra app registration.
ENTRA_REQUESTER_ROLE=Requester
ENTRA_REVIEWER_ROLE=Reviewer
# "Sign in with GitHub" for people without a work account. Off by default.
# Requires at least this repository role; users become Requesters, plus Reviewers with write access or more.
GITHUB_SIGNIN_ENABLED=false
GITHUB_SIGNIN_MIN_ROLE=triage
# Dev users "name:Role[,Role]:github_login;..." (development only).
DEV_USERS=alice:Requester:alice-gh;bob:Reviewer:bob-gh;carol:Requester,Reviewer:carol-gh;dave:Reviewer:dave-gh;erin:Reviewer:erin-gh

# ---------------------------------------------------------------- GitHub (one GitHub App, two token kinds)
# app | fake. fake = in-memory GitHub for local development and tests (development/test only).
GITHUB_MODE=fake
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com
# owner/name of the repository that runs AISDLC. Use a TEST repository until you are ready.
GITHUB_REPOSITORY=
GITHUB_BASE_BRANCH=main
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM private key of the App (use \n for newlines) or a path to the .pem file. Key Vault in Azure.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
# Optional; looked up from the repository when empty.
GITHUB_APP_INSTALLATION_ID=
# OAuth credentials of the same GitHub App (user access tokens for "Connect GitHub").
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Secret configured on the App's webhook; required in production.
GITHUB_WEBHOOK_SECRET=
# Fernet key(s) for encrypting user tokens at rest; comma-separated for rotation (first encrypts).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
GITHUB_MAX_RETRIES=3

# ---------------------------------------------------------------- intake limits
MAX_FILES=20
MAX_FILE_BYTES=26214400
MAX_TOTAL_BYTES=104857600
MAX_REQUEST_BYTES=115343360
MAX_PAGES=500
MAX_SLIDES=500
MAX_SHEET_CELLS=200000
MAX_EXTRACTED_CHARS_PER_FILE=2000000
MAX_PASTED_CHARS=500000
EXTRACTION_TIMEOUT_SECONDS=60
# process (required in production) | inline (tests only)
EXTRACTION_ISOLATION=process
EXTRACTION_MEMORY_MB=1024
ZIP_MAX_ENTRIES=5000
ZIP_MAX_UNCOMPRESSED_BYTES=314572800
ZIP_MAX_RATIO=150
# PNG/JPG via OCR (needs the `ocr` extra and Tesseract). Off by default.
FEATURE_OCR=false
# "package.module:function" malware scanner; empty = no-op (see app/extract/scan.py).
MALWARE_SCAN_HOOK=
DRAFT_TTL_MINUTES=120
# Issue body / comment budgets (GitHub limit is 65,536 characters).
ISSUE_BODY_BUDGET=60000
ISSUE_COMMENT_BUDGET=60000
# Total text made visible to AISDLC through the issue (body + continuation comments).
MAX_ISSUE_VISIBLE_CHARS=900000
# Commit full extracted text (and originals) to an intake/<request-id> branch. Never main.
OVERFLOW_BRANCH_ENABLED=true
UPLOAD_ORIGINALS=true
# The branch is refused on public repositories unless this is true.
ALLOW_PUBLIC_REPO_UPLOADS=false
RETAIN_EXTRACTED_TEXT_DAYS=0
IDEMPOTENCY_WINDOW_MINUTES=15

# ---------------------------------------------------------------- review policy
# strict: Approve only for code owners of a changed file | advisory: warn only
CODEOWNERS_POLICY=strict
# Requester cannot approve SOD_STAGES of their own requirement.
SEPARATION_OF_DUTIES=false
SOD_STAGES=["brd","prd"]
# GitHub logins always assigned as reviewers (JSON list).
DEFAULT_REVIEWERS=[]
# Refuse ", `, $ and \ in /agent notes until feedback-handler.yml stops interpolating comments into shell.
BLOCK_SHELL_METACHARACTERS=true
PRODUCTION_CONFIRMATION_WORD=promote
PRODUCTION_WORKFLOW_FILE=deploy-production.yml
PRODUCTION_ENVIRONMENT=production
PRODUCTION_EVIDENCE_WORKFLOWS=["CI — SmartServe Build & Test","CodeQL","Security — Secret Scan","Deploy — DEV","Deploy — STAGING"]

# ---------------------------------------------------------------- status tracking
POLL_INTERVAL_SECONDS=120
POLLER_ENABLED=true

# ---------------------------------------------------------------- rate limits (per user per minute)
RATE_LIMIT_SUBMIT_PER_MIN=6
RATE_LIMIT_ACTIONS_PER_MIN=30
RATE_LIMIT_READS_PER_MIN=240

# ================================================================ AISDLC Studio (app.studio.main)
# Separate shared-sign-in app; see README "AISDLC Studio". Same rule: environment variables only.
STUDIO_USERNAME=admin
# Required, no default. Use a strong value anywhere other than your own machine. (Key Vault / K8s secret)
STUDIO_PASSWORD=
# 32+ random characters; required in production. (Key Vault / K8s secret)
# SESSION_SECRET=
# PUBLIC_BASE_URL=http://localhost:8001
# DATA_DIR=var/studio
# AISDLC_SOURCE_DIR=/opt/aisdlc
USE_LLM=true
ENABLE_CODE_STAGE=true
MAX_CONCURRENT_RUNS=1
STAGE_TIMEOUT_SECONDS=3600
# Fine-grained PAT of a Copilot-licensed user, for the Copilot CLI on servers. (Key Vault / K8s secret)
# COPILOT_GITHUB_TOKEN=
